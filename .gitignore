# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js

# build output & caches
dist
build
coverage
.vite
*.tsbuildinfo

# test artifacts
/playwright-report
/test-results
/blob-report

# secrets & local env (never commit — see antinode-plan for where secrets live)
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
*.swp
*.code-workspace

# Claude local memory buffer + agent worktrees (kept local, not shared)
.remember/
.claude/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TouchDesigner project binaries (large .toe files stay untracked; see touchdesigner/)
*.toe

# T13 debug evidence (owner screenshots + chrome://gpu dumps) — reviewed in-session,
# kept local; the findings live in antinode-plan/tasks/T13-*.md.
screenshots/
about-gpu-*.txt
